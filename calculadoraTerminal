// Exercício prático sobre o uso da condição Switch Case.

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner read = new Scanner(System.in);

        System.out.println("=================");
        System.out.println("   CALCULADORA   ");
        System.out.println("=================");

        System.out.println("Escolha uma operação: \n");

        String operacoes = """
                SOMA [+]
                SUBTRAÇÃO [-]
                MULTIPLICAÇÃO [*]
                DIVISÃO [/]
                """;

        System.out.println(operacoes);

        System.out.print("Digite a operação: ");
        char operacao = read.next().charAt(0);

        System.out.print("Digite o primeiro número: ");
        double numero1 = read.nextDouble();

        System.out.print("Digite o segundo número: ");
        double numero2 = read.nextDouble();

        switch (operacao) {
            case '+' -> System.out.println("A soma é = " + (numero1 + numero2));
            case '-' -> System.out.println("A subtração é =  " + (numero1 - numero2));
            case '*' -> System.out.println("A multiplicação é = " + (numero1 * numero2));
            case '/' -> System.out.println("A divisão é = " + (numero1 / numero2));
            default -> System.out.println("Operação inválida.");
        }

        read.close();
    }
}
